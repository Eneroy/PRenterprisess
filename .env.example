# ==============================================================================
# PR ENTERPRISES SOLAR EPC PLATFORM - ENVIRONMENT VARIABLES
# Service Areas: Tundla, Agra, Firozabad (Uttar Pradesh, India)
# Helpline: +91 6395934649
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTH (Optional for local testing, required for cloud production)
# ------------------------------------------------------------------------------
# The platform functions with built-in reactive storage out of the box.
# When your Supabase project is created, paste your Project URL and Anon Public Key below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. WHATSAPP CLICK-TO-CHAT & META CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
# Default country code: 91, business phone: 6395934649
NEXT_PUBLIC_WHATSAPP_NUMBER=916395934649

# Optional: Meta WhatsApp Cloud API credentials for automated template dispatch
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-waba-id

# ------------------------------------------------------------------------------
# 3. PRODUCTION HOSTING (Vercel)
# ------------------------------------------------------------------------------
VERCEL_ENV=production
